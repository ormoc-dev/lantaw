# Local secrets — copy to .env (gitignored), then run: npm run sync-env
# On Vercel, set the same keys in Project → Settings → Environment Variables.
# Browser apps cannot read .env at runtime; sync-env writes src/config/env.js.

# Supabase → Project Settings → API
# Use the publishable key (sb_publishable_...) or legacy anon JWT — never the DB password / service_role
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Public site URL (Vercel). Auth redirects use window.location at runtime (PKCE).
VITE_SITE_URL=http://localhost

# TMDB → https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=YOUR_TMDB_API_KEY
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# OMDb → https://www.omdbapi.com/apikey.aspx (API key from email, not VERIFYKEY)
VITE_OMDB_API_KEY=YOUR_OMDB_API_KEY

# Giphy (Friends chat GIF suggestions) — Tenor no longer gives new keys
# Create an app key: https://developers.giphy.com/dashboard/
VITE_GIPHY_API_KEY=JBZCJrkClnaQwVKJ7QevPZfOsRYT891k
